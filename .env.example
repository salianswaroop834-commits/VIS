# ==============================================================================
# Nexisure Vehicle Insurance Platform - Environment Configuration Template
# NOTE: Copy this file to '.env' and fill in your confidential credentials.
# NEVER commit the actual '.env' file containing real secrets to version control.
# ==============================================================================

# --- Django Core Settings ---
DJANGO_SECRET_KEY=django-insecure-nexisure-dev-key-change-in-production-@2026
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# --- Database / Supabase PostgreSQL ---
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# When blank or unreachable, platform falls back cleanly to local SQLite for isolated dev/testing.
DATABASE_URL=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- MLflow & MLOps Configuration ---
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_NAME=nexisure_claim_prediction

# --- LLM & RAG Provider ---
# Compatible with OpenAI or OpenAI-compatible MaaS / local LLM proxies
OPENAI_API_KEY=your-api-key-here
LLM_MODEL_NAME=gpt-4o-mini
EMBEDDING_MODEL_NAME=text-embedding-3-small

# --- Email / OTP Delivery (Console backend for safe local development) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
