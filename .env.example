# ==============================================================================
# Nexisure Vehicle Insurance Platform - Environment Configuration Template
# NOTE: Copy this file to '.env' and fill in your confidential credentials.
# NEVER commit the actual '.env' file containing real secrets to version control.
# ==============================================================================

# --- Django Core Settings ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# --- Database / Supabase PostgreSQL ---
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- RapidAPI External Integrations (PAN & Vehicle Lookup) ---
RAPIDAPI_KEY=
RAPIDAPI_PAN_HOST=
RAPIDAPI_VEHICLE_HOST=

# --- Firebase Two-Factor Authentication (Phone OTP) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- LLM & RAG Embedding Providers ---
LLM_API_KEY=
EMBEDDING_API_KEY=
LLM_MODEL_NAME=gpt-4o-mini
EMBEDDING_MODEL_NAME=text-embedding-3-small

# --- MLflow & MLOps Configuration ---
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_NAME=nexisure_claim_prediction

# --- Email / OTP Delivery (Console backend for safe local development) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
